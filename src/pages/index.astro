  { area: '2/5/3/6', fill: '#CFD3B2' },
  { area: '3/1/4/2', fill: '#BCC7A6' },
  { area: '3/2/4/3', fill: '#D3D5B6' },
  { area: '3/5/4/6', fill: '#A9B695' },
  { area: '4/3/5/4', fill: '#C6CDAB' },
