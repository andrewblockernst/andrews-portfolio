        { when: 'Feb 2022 — Nov 2022', role: 'Inventory Manager & Waiter', org: "The O'Malley Group · Dublin, Ireland", text: 'Promoted to Inventory Manager: stock control, supplier coordination and operational support in a multicultural environment.' },
        { when: 'Dec 2020 — Jul 2021', role: 'Logistics Operator / Archive Analyst', org: 'Alimentos Granix · Buenos Aires', text: 'Product logistics, inventory control and physical and digital record archiving.' },
      ],
    },
    edu: {
      tag: 'Education',
      items: [
        { when: '2023 — 2027', title: 'B.S. in Information Systems Engineering', org: 'Universidad Adventista del Plata, Argentina' },
        { when: '2020', title: 'High School Diploma · Finance & Business Administration', org: 'Instituto Adventista Florida, Argentina' },
      ],
    },
    stack: {
      tag: 'Stack', h2: 'Tools', hint: 'The problem picks the tool.',
      groups: [
        { name: 'Languages', items: ['TypeScript', 'JavaScript', 'C#', 'Python', 'Java', 'SQL'] },
        { name: 'Frontend', items: ['Next.js', 'Nuxt.js', 'React', 'Vue', 'Astro', 'Tailwind', 'Vuetify'] },
        { name: 'Backend & data', items: ['ASP.NET', '.NET', 'PostgreSQL', 'SQL Server', 'Supabase', 'Prisma ORM', 'REST APIs'] },
        { name: 'Tooling', items: ['Git', 'GitHub', 'Docker', 'nginx', 'n8n', 'WhatsApp API', 'CI/CD'] },
        { name: 'Methods', items: ['Scrum', 'Agile', 'Kanban'] },
        { name: 'Languages spoken', items: ['Native Spanish', 'English B2 · Cambridge'] },
      ],
    },
    life: {
      tag: 'Interests', h2: 'Besides the code',
      items: [
        { title: 'Travel', text: 'Dublin, Paris and whatever comes next.' },
        { title: 'Sport', text: 'Routine and consistency, mostly outdoors.' },
        { title: 'Writing', text: 'Notes, ideas and drafts to sort out what I think.' },
        { title: 'Cooking', text: 'Recipes, timing, trial and error.' },
        { title: 'Editing', text: 'Video and image: composition and rhythm.' },
        { title: 'Trades', text: "Hands-on work: how things are actually built." },
        { title: 'Meeting people', text: 'Conversations with people unlike me.' },
        { title: 'Volunteering', text: 'Community projects and youth clubs.' },
      ],
    },
    contact: { tag: 'Contact', where: 'Location', cv: 'CV', built: 'Built with Astro' },
