---
import '@fontsource-variable/archivo';

/* ── bilingual content ── */
const COPY = {
  es: {
    nav: { about: 'Sobre mí', work: 'Proyectos', exp: 'Experiencia', stack: 'Stack', life: 'Intereses', contact: 'Contacto' },
    hero: { role: 'Full Stack Developer', cta1: 'Proyectos', cta2: 'Descargar CV' },
    about: {
      tag: 'Sobre mí',
      caption: 'París, 2025',
      h2a: 'Entender el problema ',
      h2b: 'antes de elegir el stack.',
      p1: 'Soy Analista de Desarrollo e Infraestructura en la Unión Argentina y estudiante de 4° año de Ingeniería en Sistemas. Además del desarrollo, me apasionan las redes y la seguridad de la infraestructura. Me impulsa la mejora continua, buscando proyectos para diseñar soluciones integrales que resuelvan problemas reales.',
