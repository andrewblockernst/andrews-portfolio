        { when: 'Feb 2022 — Nov 2022', role: 'Gerente de Inventario & Mozo', org: "The O'Malley Group · Dublín, Irlanda", text: 'Promovido a gerente de inventario: control de stock, pedidos a proveedores y soporte operativo en un entorno multicultural.' },
        { when: 'Dic 2020 — Jul 2021', role: 'Operador Logístico / Analista de Archivo', org: 'Alimentos Granix · Buenos Aires', text: 'Logística de productos, control de inventario y archivo de registros físicos y digitales.' },
      ],
    },
    edu: {
      tag: 'Educación',
      items: [
        { when: '2023 — 2027', title: 'Ingeniería en Sistemas de Información', org: 'Universidad Adventista del Plata, Argentina' },
        { when: '2020', title: 'Diploma Secundario · Finanzas y Administración', org: 'Instituto Adventista Florida, Argentina' },
