    <script is:inline define:vars={{ esProjects: JSON.stringify(PROJECTS.es), enProjects: JSON.stringify(PROJECTS.en) }}>
      /* @ts-ignore: vars injected by Astro */
      const PROJECTS_ES = JSON.parse(esProjects);
      /* @ts-ignore: vars injected by Astro */
      const PROJECTS_EN = JSON.parse(enProjects);

      /* ── Language toggle ── */
      const root = document.documentElement;
      document.querySelectorAll('[data-set-lang]').forEach(btn => {
        btn.addEventListener('click', () => {
          const lang = btn.getAttribute('data-set-lang');
          root.setAttribute('data-lang', lang);
          root.setAttribute('lang', lang);
          try { localStorage.setItem('lang', lang); } catch (e) {}
        });
      });
      try {
        const saved = localStorage.getItem('lang');
        if (saved) { root.setAttribute('data-lang', saved); root.setAttribute('lang', saved); }
      } catch (e) {}

      /* ── Scroll reveal ── */
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.style.opacity = '1';
            e.target.style.transform = 'none';
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));

      /* ── 3D Map ── */
      const plotMap = document.getElementById('plot-map');
      const narrow = window.matchMedia('(max-width: 860px)');
      function updateMapTf() {
        plotMap.style.transform = narrow.matches
          ? 'rotateX(38deg) rotateZ(-4deg) scale(0.96)'
          : 'rotateX(52deg) rotateZ(-14deg)';
      }
      updateMapTf();
      narrow.addEventListener('change', updateMapTf);

      /* ── Project hover/click ── */
      const panelTitle = document.getElementById('panel-title');
      const panelDesc = document.getElementById('panel-desc');
      const panelTags = document.getElementById('panel-tags');
      const panelCounter = document.getElementById('panel-counter');
      const panelPreview = document.getElementById('panel-preview');
      const panelImgLabel = document.getElementById('panel-img-label');
      const fillers = document.querySelectorAll('.plot-filler');

      function getLang() { return root.getAttribute('data-lang') || 'es'; }
      function getProjects() { return getLang() === 'en' ? PROJECTS_EN : PROJECTS_ES; }

      const emptyES = { title: 'El terreno', desc: 'Cuatro parcelas trabajadas y varias en preparación. Las parcelas marcadas con un punto son proyectos; el resto es campo por sembrar.', tags: ['Full Stack', 'Producto', 'Automatización'] };
      const emptyEN = { title: 'The land', desc: 'Four worked plots and a few still being prepared. Plots marked with a dot are projects; the rest is field waiting to be sown.', tags: ['Full Stack', 'Product', 'Automation'] };

      function setPanel(project) {
        if (!project) {
          const empty = getLang() === 'en' ? emptyEN : emptyES;
          panelTitle.innerHTML = '<span class="lang-es">' + emptyES.title + '</span><span class="lang-en">' + emptyEN.title + '</span>';
          panelDesc.innerHTML = '<span class="lang-es">' + emptyES.desc + '</span><span class="lang-en">' + emptyEN.desc + '</span>';
          panelTags.innerHTML = empty.tags.map(t => '<span class="tech-tag">' + t + '</span>').join('');
          panelCounter.textContent = '— / 04';
          panelPreview.className = 'preview-stripes';
          panelImgLabel.innerHTML = '<span class="lang-es">Pasá por una parcela para previsualizar</span><span class="lang-en">Hover a plot to preview the project</span>';
          fillers.forEach(f => f.style.filter = 'saturate(1)');
          return;
        }
        panelTitle.textContent = project.name;
        panelDesc.textContent = project.desc;
        panelTags.innerHTML = project.tags.map(t => '<span class="tech-tag">' + t + '</span>').join('');
        panelCounter.textContent = project.num + ' / 04';
        panelPreview.className = '';
        panelPreview.style.background = '#E8E7D3';
        panelImgLabel.textContent = project.name;
        fillers.forEach(f => f.style.filter = 'saturate(0.82) brightness(0.97)');
      }

      const counter = () => narrow.matches ? 'rotateZ(4deg) rotateX(-38deg)' : 'rotateZ(14deg) rotateX(-52deg)';

      function highlightPlot(id) {
        document.querySelectorAll('.plot-project').forEach(el => {
          const pid = el.dataset.projectId;
          const on = pid === id;
          el.style.transform = on ? 'translateZ(34px)' : 'translateZ(6px)';
          el.style.boxShadow = on ? '0 26px 34px -20px rgba(38,51,46,0.65)' : '0 10px 16px -12px rgba(38,51,46,0.4)';
          el.querySelector('.plot-glow').style.opacity = on ? '1' : '0';
          el.querySelector('.plot-dot').style.opacity = on ? '0' : '0.55';
          const bubble = el.querySelector('.plot-bubble');
          if (bubble) {
            bubble.style.transform = counter() + (on ? ' translateY(-62px) scale(1)' : ' translateY(6px) scale(0.18)');
            bubble.style.opacity = on ? '1' : '0';
          }
        });
        document.querySelectorAll('.project-row').forEach(el => {
          el.style.background = el.dataset.projectId === id ? '#E9E8D3' : '#F2F1E4';
        });
      }

      function unhighlightAll() {
        currentHover = null;
        highlightPlot(null);
        setPanel(null);
      }

      // Plot events
      document.querySelectorAll('.plot-project').forEach(el => {
        el.addEventListener('mouseenter', () => {
          const p = getProjects().find(pr => pr.id === el.dataset.projectId);
          highlightPlot(el.dataset.projectId);
          setPanel(p);
        });
        el.addEventListener('mouseleave', unhighlightAll);
        el.addEventListener('click', () => openModal(el.dataset.projectId));
      });

      // Row events
      document.querySelectorAll('.project-row').forEach(el => {
        el.addEventListener('mouseenter', () => {
          const p = getProjects().find(pr => pr.id === el.dataset.projectId);
          highlightPlot(el.dataset.projectId);
          setPanel(p);
        });
        el.addEventListener('mouseleave', unhighlightAll);
        el.addEventListener('click', () => openModal(el.dataset.projectId));
      });

      /* ── Modal ── */
      const modal = document.getElementById('project-modal');
      const modalName = document.getElementById('modal-name');
      const modalMeta = document.getElementById('modal-meta');
      const modalDesc = document.getElementById('modal-desc');
      const modalRows = document.getElementById('modal-rows');
      const modalTags = document.getElementById('modal-tags');
      const modalUrlWrap = document.getElementById('modal-url-wrap');
      const modalClose = document.getElementById('modal-close');
      const modalInner = document.getElementById('modal-inner');

      function openModal(id) {
        const p = getProjects().find(pr => pr.id === id);
        if (!p) return;
        modalName.textContent = p.name;
        modalMeta.textContent = p.num + ' · ' + p.kind;
        modalDesc.textContent = p.desc;
        modalRows.innerHTML = p.rows.map(r =>
          '<div style="display:flex; justify-content:space-between; gap:18px; padding:12px 2px; background:#F2F1E4">' +
          '<span style="font-size:11.5px; letter-spacing:0.1em; text-transform:uppercase; color:#8A9890">' + r.k + '</span>' +
          '<span style="font-size:14px; color:#3B4B45; text-align:right">' + r.v + '</span></div>'
        ).join('');
        modalTags.innerHTML = p.tags.map(t => '<span class="tech-tag">' + t + '</span>').join('');
        if (p.url) {
          const visitText = getLang() === 'en' ? 'Visit site' : 'Ver el sitio';
          modalUrlWrap.innerHTML = '<a href="' + p.url + '" target="_blank" rel="noopener" class="btn-primary">' + visitText + ' ↗</a>';
        } else {
          modalUrlWrap.innerHTML = '';
        }
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }

      modalClose.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      modalInner.addEventListener('click', (e) => e.stopPropagation());
      window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
    </script>

    <style is:global>
      * { box-sizing: border-box; }
      :root { font-family: 'Archivo Variable', system-ui, sans-serif; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: #F2F1E4; color: #26332E; -webkit-font-smoothing: antialiased; }
      a { color: #4E635E; text-decoration: none; }
      a:hover { color: #26332E; }
      ::selection { background: #A6B49E; color: #22302B; }

      /* language toggle */
      html[data-lang='es'] .lang-en { display: none !important; }
      html[data-lang='en'] .lang-es { display: none !important; }

      .lang-btn { transition: background-color .15s, color .15s; color: #4E635E; background: transparent; }
      html[data-lang='es'] .lang-btn[data-set-lang='es'],
      html[data-lang='en'] .lang-btn[data-set-lang='en'] { background: #26332E; color: #EFEEDC; }

      /* nav hide on mobile */
      @media (max-width: 680px) {
        .main-nav { display: none !important; }
      }

      /* buttons */
      .btn-primary {
        display: inline-flex; align-items: center; padding: 12px 24px;
        background: #26332E; color: #EFEEDC; font-weight: 700; font-size: 12.5px;
        letter-spacing: 0.1em; text-transform: uppercase; transition: all .2s ease;
        box-shadow: 0 4px 14px rgba(38,51,46,0.2);
      }
      .btn-primary:hover { background: #4E635E; color: #F2F1E4; transform: translateY(-2px); box-shadow: 0 6px 18px rgba(38,51,46,0.28); }
      .btn-outline {
        display: inline-flex; align-items: center; padding: 12px 24px;
        background: rgba(242,241,228,0.5); backdrop-filter: blur(4px);
        border: 1px solid rgba(38,51,46,0.4); color: #26332E; font-weight: 700;
        font-size: 12.5px; letter-spacing: 0.1em; text-transform: uppercase; transition: all .2s ease;
      }
      .btn-outline:hover { background: rgba(255,255,255,0.8); transform: translateY(-2px); box-shadow: 0 4px 14px rgba(0,0,0,0.08); }

      /* section shared */
      .section-tag {
        margin: 0 0 12px; font-weight: 700; font-size: 11.5px;
        letter-spacing: 0.18em; text-transform: uppercase; color: #8A9890;
      }
      .section-h2 {
        margin: 0; font-weight: 700;
        font-size: clamp(26px, 4.2vw, 46px); line-height: 1.05;
        letter-spacing: -0.03em; color: #22302B;
      }
      .about-text p {
        margin: 0 0 12px; font-size: clamp(15px, 1.3vw, 16.5px);
        line-height: 1.58; color: #3B4B45; max-width: 56ch; text-wrap: pretty;
      }

      /* tech tags */
      .tech-tag {
        font-size: 11px; padding: 5px 8px;
        background: rgba(166,180,158,0.36); color: #3F534D;
      }

      /* stack pills & carousel */
      .stack-pill {
        font-size: 12.5px; padding: 6px 10px;
        background: #E5E4CE; color: #3B4B45;
        border: 1px solid rgba(79,99,94,0.14); transition: background .2s ease, color .2s ease;
      }
      .stack-pill:hover { background: #A6B49E; color: #22302B; }
      .tech-carousel-container {
        width: 100%; overflow: hidden; position: relative; display: flex;
        mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
      }
      .tech-carousel-track {
        display: flex; gap: 10px; width: max-content;
      }
      .scroll-left { animation: marquee-left 36s linear infinite; }
      .scroll-right { animation: marquee-right 40s linear infinite; }
      .scroll-left-slow { animation: marquee-left 34s linear infinite; }
      .tech-carousel-track:hover { animation-play-state: paused; }
      @keyframes marquee-left {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-25%, 0, 0); }
      }
      @keyframes marquee-right {
        0% { transform: translate3d(-25%, 0, 0); }
        100% { transform: translate3d(0, 0, 0); }
      }
      .carousel-pill {
        font-size: 12.5px; padding: 6px 12px;
        background: #E5E4CE; color: #3B4B45;
        border: 1px solid rgba(79,99,94,0.18);
        opacity: 0.5; white-space: nowrap; display: inline-block; cursor: default;
        transition: opacity .2s ease, background .2s ease, color .2s ease, transform .2s ease;
      }
      .carousel-pill:hover {
        opacity: 1; background: #A6B49E; color: #22302B; transform: scale(1.05);
      }

      /* interest pills & carousel */
      .interest-card:hover { transform: translateY(-4px); background: #F2F1E4; }
      .interest-pill {
        font-size: 13.5px; padding: 8px 16px;
        background: rgba(242,241,228,0.75); color: #3B4B45;
        border: 1px solid rgba(79,99,94,0.22);
        opacity: 0.65; white-space: nowrap; display: inline-flex; align-items: center; gap: 10px; cursor: default;
        transition: opacity .2s ease, background .2s ease, color .2s ease, transform .2s ease;
      }
      .interest-pill:hover {
        opacity: 1; background: #F2F1E4; color: #22302B; transform: scale(1.04);
      }

      /* preview stripes */
      .preview-stripes {
        background: repeating-linear-gradient(135deg, #DEDDC4 0 9px, #D5D5BA 9px 18px) !important;
      }

      /* project row hover */
      .project-row:hover { background: #E9E8D3 !important; }
      .project-row:hover .row-arrow { transform: translateX(4px); }

      /* contact */
      .email-link {
        display: inline-block; font-size: clamp(14px, 1.8vw, 19px);
        color: #A6B49E; border-bottom: 1px solid rgba(166,180,158,0.5);
        padding-bottom: 3px; transition: color .2s ease;
      }
      .email-link:hover { color: #F0EFDC; }
      .contact-link {
        display: flex; justify-content: space-between; align-items: center;
        gap: 16px; padding: 16px 4px; background: #26332E;
        color: #E8E7D3; font-size: 15px; transition: color .2s ease;
      }
      .contact-link:hover { color: #A6B49E; }

      /* modal */
      .modal-overlay {
        position: fixed; inset: 0; z-index: 90;
        background: rgba(38,51,46,0.62); backdrop-filter: blur(4px);
        display: flex; align-items: center; justify-content: center;
        padding: clamp(16px, 4vw, 48px);
      }
      .modal-content {
        width: 100%; max-width: 660px; max-height: 86vh; overflow-y: auto;
        background: #F2F1E4; padding: clamp(26px, 4vw, 44px);
        box-shadow: 0 40px 90px -30px rgba(0,0,0,0.5);
      }
    </style>
  </body>
</html>
