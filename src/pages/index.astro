    contact: { tag: 'Contacto', where: 'Ubicación', cv: 'CV', built: 'Hecho con Astro' },
  },
  en: {
    nav: { about: 'About', work: 'Work', exp: 'Experience', stack: 'Stack', life: 'Interests', contact: 'Contact' },
    hero: { role: 'Full Stack Developer', cta1: 'Projects', cta2: 'Download CV' },
    about: {
      tag: 'About',
      caption: 'Paris, 2025',
      h2a: 'Understand the problem ',
      h2b: 'before picking the stack.',
      p1: 'I am a Development and Infrastructure Analyst at the Argentine Union and a 4th-year Information Systems Engineering student. I am driven by continuous improvement, with a special interest in networking, telecommunications, and security. I am always looking for new opportunities to build robust technological solutions that solve real-world problems.',
      p2: "I manage the software lifecycle end-to-end. I build full-stack applications, design modern interfaces, and administer Linux infrastructure. I lead the workflow, acting as a direct bridge between technical requirements and the user's actual needs.",
      p3: 'My previous experience in purchasing and logistics in Argentina and Ireland helped me develop soft skills that I apply every day. I learned to listen empathetically to understand the real need behind every problem, and to communicate technical solutions in a clear and approachable way.'
    },
    work: {
      tag: 'Work', h2: 'One plot, one project',
      hint: 'Move across the map. Click a plot to open its detail.',
      legend: 'Plot', visit: 'Visit site',
      empty: { title: 'The land', desc: 'Four worked plots and a few still being prepared. Plots marked with a dot are projects; the rest is field waiting to be sown.', tags: ['Full Stack', 'Product', 'Automation'] },
    },
    exp: {
      tag: 'Experience', h2: 'The route so far',
      items: [
        { when: 'Dec 2025 — Present', role: 'Full Stack Developer', org: 'Unión Argentina · Seventh-day Adventist Church', text: 'Development and maintenance of internal web systems for organisational management. Features with Nuxt.js, Prisma ORM, REST APIs, .NET, C# and SQL Server; infrastructure improvement and user support, working with multidisciplinary teams.' },
        { when: '2024 — Present', role: 'Full Stack Developer', org: 'Fisiopasteur · Kinesiology Centre', text: 'Web app digitising patient management, with automated WhatsApp reminders. Also acting as Scrum Manager: sprint planning, backlog refinement and ongoing client communication.' },
