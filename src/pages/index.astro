        { name: 'Frontend', items: ['Next.js', 'Nuxt.js', 'React', 'Vue', 'Astro', 'Tailwind', 'Vuetify'] },
        { name: 'Backend & datos', items: ['ASP.NET', '.NET', 'PostgreSQL', 'SQL Server', 'Supabase', 'Prisma ORM', 'REST APIs'] },
        { name: 'Herramientas', items: ['Git', 'GitHub', 'Docker', 'nginx', 'n8n', 'WhatsApp API', 'CI/CD'] },
        { name: 'Metodologías', items: ['Scrum', 'Agile', 'Kanban'] },
        { name: 'Idiomas', items: ['Español nativo', 'Inglés B2 · Cambridge'] },
      ],
    },
    life: {
      tag: 'Intereses', h2: 'Además del código',
      items: [
        { title: 'Viajar', text: 'Lo que venga.' },
        { title: 'Deporte', text: 'Rutina y constancia, casi siempre al aire libre.' },
        { title: 'Escribir', text: 'Notas, ideas y textos para ordenar lo que pienso.' },
        { title: 'Cocinar', text: 'Recetas, tiempos y prueba y error.' },
        { title: 'Editar', text: 'Video e imagen: composición y ritmo.' },
        { title: 'Oficios', text: 'Trabajo manual: entender cómo se arma algo.' },
        { title: 'Conocer gente', text: 'Aprender del otro.' },
        { title: 'Voluntariado', text: 'Proyectos comunitarios y clubes juveniles.' },
