const SHAPES = ['50%', '1px', '50% 50% 50% 1px', '1px', '50%', '50% 1px 50% 1px', '50%', '1px'];
const LIFE_COLORS = ['#4E635E', '#A6B49E', '#818C78', '#93A288', '#4E635E', '#818C78', '#A6B49E', '#93A288'];

const es = COPY.es;
const en = COPY.en;
const esProjects = PROJECTS.es;
const enProjects = PROJECTS.en;

const allEsTech = es.stack.groups.flatMap(g => g.items);
const allEnTech = en.stack.groups.flatMap(g => g.items);
const midTech = Math.ceil(allEsTech.length / 2);
const techRow1Es = [...allEsTech.slice(0, midTech), ...allEsTech.slice(0, midTech), ...allEsTech.slice(0, midTech), ...allEsTech.slice(0, midTech)];
const techRow1En = [...allEnTech.slice(0, midTech), ...allEnTech.slice(0, midTech), ...allEnTech.slice(0, midTech), ...allEnTech.slice(0, midTech)];
const techRow2Es = [...allEsTech.slice(midTech), ...allEsTech.slice(midTech), ...allEsTech.slice(midTech), ...allEsTech.slice(midTech)];
const techRow2En = [...allEnTech.slice(midTech), ...allEnTech.slice(midTech), ...allEnTech.slice(midTech), ...allEnTech.slice(midTech)];

const lifeEs = es.life.items;
const lifeEn = en.life.items;
const loopLifeEs = [...lifeEs, ...lifeEs, ...lifeEs, ...lifeEs];
const loopLifeEn = [...lifeEn, ...lifeEn, ...lifeEn, ...lifeEn];
