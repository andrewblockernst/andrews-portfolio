<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Andrew Block Ernst - Portfolio" />
    <title>Andrew Block Ernst - Portfolio</title>
  </head>
  <body>
    <div style="width:100%; overflow-x:hidden; background:#F2F1E4">

      <!-- ===== HEADER ===== -->
      <header style="position:sticky; top:0; z-index:60; display:flex; flex-wrap:wrap; align-items:center; gap:14px 26px; padding:13px clamp(18px,5vw,64px); background:rgba(242,241,228,0.88); backdrop-filter:blur(10px); border-bottom:1px solid rgba(79,99,94,0.18)">
        <a href="#top" aria-label="Andrew Block Ernst" style="margin-right:auto; display:flex; align-items:center; height:30px">
          <img src="/images/logo.png" alt="Andrew Block Ernst" style="height:28px; width:auto; display:block" />
        </a>
        <nav class="main-nav" style="display:flex; flex-wrap:wrap; gap:clamp(11px,1.8vw,24px); font-size:12.5px; letter-spacing:0.04em; color:#4E635E">
          <a href="#sobre" style="padding:4px 0"><span class="lang-es">{es.nav.about}</span><span class="lang-en">{en.nav.about}</span></a>
          <a href="#proyectos" style="padding:4px 0"><span class="lang-es">{es.nav.work}</span><span class="lang-en">{en.nav.work}</span></a>
          <a href="#experiencia" style="padding:4px 0"><span class="lang-es">{es.nav.exp}</span><span class="lang-en">{en.nav.exp}</span></a>
          <a href="#stack" style="padding:4px 0"><span class="lang-es">{es.nav.stack}</span><span class="lang-en">{en.nav.stack}</span></a>
          <a href="#intereses" style="padding:4px 0"><span class="lang-es">{es.nav.life}</span><span class="lang-en">{en.nav.life}</span></a>
          <a href="#contacto" style="padding:4px 0"><span class="lang-es">{es.nav.contact}</span><span class="lang-en">{en.nav.contact}</span></a>
        </nav>
        <div style="display:flex; align-items:center; border:1px solid rgba(79,99,94,0.3); overflow:hidden; font-size:11.5px; font-weight:700; letter-spacing:0.06em">
          <button type="button" data-set-lang="es" class="lang-btn" style="border:0; cursor:pointer; padding:6px 10px; font:inherit">ES</button>
          <button type="button" data-set-lang="en" class="lang-btn" style="border:0; cursor:pointer; padding:6px 10px; font:inherit">EN</button>
        </div>
      </header>

      <!-- ===== HERO ===== -->
      <section id="top" style="position:relative; min-height:clamp(340px, 50vh, 520px); display:flex; align-items:center; justify-content:flex-start; overflow:hidden; background:linear-gradient(#CBDDE1 0%, #DCE5D9 58%, #E7E7CE 100%)">
        <div id="parA" style="position:absolute; left:0; right:0; top:0; height:50%; background:linear-gradient(180deg, #CBDDE1 0%, rgba(203,221,225,0.85) 50%, rgba(220,229,217,0) 100%); pointer-events:none; z-index:1"></div>
        <div id="parB" style="position:absolute; left:-8%; right:-8%; bottom:0; height:55%; background:linear-gradient(180deg, rgba(203,221,225,0.85) 0%, #9FB1A4 40%, #7A8B7D 100%); clip-path:polygon(0% 45%, 12% 25%, 26% 40%, 40% 10%, 55% 35%, 70% 15%, 84% 35%, 100% 20%, 100% 100%, 0% 100%); opacity:0.9"></div>
        <div id="parC" style="position:absolute; left:-8%; right:-8%; bottom:0; height:42%; background:linear-gradient(180deg, #8A9B85 0%, #72826F 100%); clip-path:polygon(0% 48%, 15% 25%, 32% 42%, 48% 18%, 64% 38%, 80% 20%, 100% 40%, 100% 100%, 0% 100%)"></div>
        <div style="position:absolute; left:0; right:0; bottom:0; height:16%; background:linear-gradient(#6E7D70, #56655C)"></div>
        <div style="position:absolute; left:0; right:0; bottom:0; height:16%; background:repeating-linear-gradient(103deg, rgba(226,224,200,0.14) 0 2px, rgba(226,224,200,0) 2px 26px)"></div>

        <div style="position:relative; z-index:2; width:100%; padding:clamp(28px,4vw,48px) clamp(18px,5vw,64px) clamp(64px,10vw,88px)">
          <div style="max-width:1180px; margin:0 auto">
            <h1 style="margin:0; font-weight:800; font-size:clamp(34px,6.8vw,88px); line-height:0.92; letter-spacing:-0.035em; text-transform:uppercase; color:#22302B">Andrew<br />Block<br />Ernst</h1>
            <div style="margin-top:clamp(12px,2vw,18px)">
              <span style="font-weight:700; font-size:clamp(12px,1.4vw,15px); letter-spacing:0.16em; text-transform:uppercase; color:#3B4B45; display:block">Full Stack Developer</span>
            </div>
            <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-start; gap:12px; margin-top:clamp(18px,3vw,28px)">
              <a href="#proyectos" class="btn-primary"><span class="lang-es">{es.hero.cta1}</span><span class="lang-en">{en.hero.cta1}</span></a>
              <a href="/assets/cv-andrew-es.pdf" target="_blank" rel="noopener" class="btn-outline lang-es">{es.hero.cta2}</a>
              <a href="/assets/cv-andrew-en.pdf" target="_blank" rel="noopener" class="btn-outline lang-en">{en.hero.cta2}</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== SOBRE MÍ ===== -->
      <section id="sobre" style="padding:clamp(36px,5vw,64px) clamp(18px,5vw,64px); background:#F2F1E4">
        <div data-reveal style="max-width:1180px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(24px,4vw,52px); align-items:start; opacity:0; transform:translateY(20px); transition:opacity .8s ease, transform .8s ease">
          <div>
            <div style="position:relative; overflow:hidden; background:#DCDCC4; aspect-ratio:4/5; max-width:430px">
              <img src="/images/retrato.jpg" alt="Andrew Block Ernst" style="width:100%; height:100%; object-fit:cover; display:block; filter:saturate(0.8) contrast(1.03)" />
              <div style="position:absolute; inset:0; background:linear-gradient(200deg, rgba(78,99,94,0.2), rgba(226,224,200,0.14))"></div>
            </div>
            <div style="margin-top:12px; font-size:11.5px; letter-spacing:0.08em; color:#6C7C74">
              <span class="lang-es">{es.about.caption}</span><span class="lang-en">{en.about.caption}</span>
            </div>
          </div>
          <div>
            <p class="section-tag"><span class="lang-es">{es.about.tag}</span><span class="lang-en">{en.about.tag}</span></p>
            <h2 style="margin:0 0 18px; font-weight:700; font-size:clamp(27px,4vw,44px); line-height:1.06; letter-spacing:-0.025em; color:#22302B; max-width:24ch; text-wrap:balance">
              <span class="lang-es">{es.about.h2a}<span style="color:#8A9890">{es.about.h2b}</span></span>
              <span class="lang-en">{en.about.h2a}<span style="color:#8A9890">{en.about.h2b}</span></span>
            </h2>
            <div class="about-text">
              <p><span class="lang-es">{es.about.p1}</span><span class="lang-en">{en.about.p1}</span></p>
              <p><span class="lang-es">{es.about.p2}</span><span class="lang-en">{en.about.p2}</span></p>
